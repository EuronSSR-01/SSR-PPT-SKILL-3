   "Noto Sans SC"
  ]
 },
 {
  "section": "convert",
  "id": "C04-b",
  "title": "开放日人数 B：改写后，按大致位置摆",
  "note": "展点按校园里的大致方位摆，圆越大人次越多，排长队的两处换色并配沙漏，入口画在南门。看得出各展点的相对方位和人流集中在哪一片；位置示意不按比例，不能据此判断距离或规划路线；比较多少要在圆之间来回找。11 条信息：8 条在图里，时间和口径留在图例。",
  "file": "convert/C04-b.png",
  "source": "examples/gallery/convert_examples.py",
  "fonts": [
   "Noto Sans SC"
  ]
 },
 {
  "section": "convert",
  "id": "C04-c",
  "title": "开放日人数 C：同一份数据，按人次排序",
  "note": "同样的七个数按多少排成条形图，超过 1,000 的两根换色、旁边写排队：一眼比出谁多谁少，适合排名和取舍；看不出位置，入口只能写在旁边。B、C 都没丢信息，按这一页要回答的问题选：问“在哪里”用位置，问“谁多”用排序。",
  "file": "convert/C04-c.png",
  "source": "examples/gallery/convert_examples.py",
  "fonts": [
   "Noto Sans SC"
  ]
 },
