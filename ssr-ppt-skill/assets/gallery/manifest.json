 {
  "section": "convert",
  "id": "C01-b",
  "title": "门诊时间 B：改写后，一根时间条加四张小图",
  "note": "从签到到取药画成一根按分钟比例的时间条，候诊一段最长、用强调色；候诊的变化和目标画成三根条，挂号方式画成比例条，要做检查的患者画成十个人里涂四个，取药机画成六台。“不需要做检查”“约”“预计”都留在图旁。12 条信息：10 条在图里，字只剩标题和一行口径。",
  "file": "convert/C01-b.png",
  "source": "examples/gallery/convert_examples.py",
  "fonts": [
   "Noto Sans SC"
  ]
 },
 {
  "section": "convert",
  "id": "C02-a",
  "title": "边角料去向 A：改写前，分段要点",
  "note": "三个去向各写一两句，建议放在右边：吨数、结算方式、处置费都埋在句子里，看不出量的大小和流向。材料与 B 页相同（SCRAP_FACTS），13 条信息全是字。",
  "file": "convert/C02-a.png",
  "source": "examples/gallery/convert_examples.py",
  "fonts": [
   "Noto Sans SC"
  ]
 },
 {
  "section": "convert",
  "id": "C02-b",
  "title": "边角料去向 B：改写后，按吨数画宽窄的流向",
  "note": "工厂插画出发，三条流向按吨数画宽窄（2 像素 = 1 吨），结算和拉运方式写在回收商那条上；回收商配货车插画，填埋一条换成强调色。建议画成填埋 12 → 0 和两根处置费条，多付的钱写成数字。13 条信息：10 条在图里。",
  "file": "convert/C02-b.png",
  "source": "examples/gallery/convert_examples.py",
  "fonts": [
   "Noto Sans SC"
  ]
 },
 {
  "section": "convert",
  "id": "C03-a",
  "title": "图书馆改造 A：改写前，两栏要点",
  "note": "改造前后的变化写成一列句子，费用和下一步写在右边：座位、时间、人次都要读完才比得出。材料与 B 页相同（LIB_FACTS），10 条信息全是字。",
  "file": "convert/C03-a.png",
  "source": "examples/gallery/convert_examples.py",
  "fonts": [
   "Noto Sans SC"
  ]
 },
 {
  "section": "convert",
  "id": "C03-b",
  "title": "图书馆改造 B：改写后，六个小图各管一件事",
  "note": "座位画成方格（一格 20 个，期中考试周高峰预计还缺的两格用虚线），开放时间画在一条时间轴上、晚上延长的一段换色，人次画成两根柱，新增的借还机和讨论室直接画出台数和间数，费用画成比例条，建议画成一周七格、周六虚线。10 条信息：9 条在图里。",
  "file": "convert/C03-b.png",
  "source": "examples/gallery/convert_examples.py",
  "fonts": [
   "Noto Sans SC"
  ]
 },
 {
  "section": "convert",
  "id": "C04-a",
  "title": "开放日人数 A：改写前，七行数字",
  "note": "七个展点一行一个数字，排队和入口写在最后：要逐行读、自己比大小，也看不出人挤在哪里。材料与 B、C 页相同（SITES、OPEN_FACTS），11 条信息全是字；B 页的方位另取自为示例设定的示意布局（PLACES）。",
  "file": "convert/C04-a.png",
  "source": "examples/gallery/convert_examples.py",
